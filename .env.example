# ===== Firebase (modelo: NÃO contém segredos - pode ser versionado) =====
# Copie este ficheiro para ".env" e preencha com os valores reais.
# O ficheiro .env está no .gitignore e NÃO deve ser enviado ao git.

# Identificadores comuns
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=

# Web
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MEASUREMENT_ID=

# Android
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=

