rules_version = '2';

// Regras de seguranca do Firestore do CashCtrl.
//
// Principio: isolamento completo por UID (RN02). Cada usuario so pode ler/
// escrever documentos dentro do seu proprio "namespace" (users/{uid}/...).
// Nao ha colecoes globais acessiveis aos clientes.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Perfil do usuario + dados do negocio ---
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // --- Subcolecoes privadas por usuario (RN02) ---

      // Movimentacoes (receitas e despesas)
      // RN01: valor deve ser numero e maior que zero.
      match /transactions/{txId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;
      }

      // Orcamentos mensais por categoria
      match /budgets/{budgetId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Parque de insumos (materiais comprados p/ fabricar produtos)
      // RN01: purchasePrice >= 0 e packageQuantity > 0 quando presentes.
      match /ingredients/{ingredientId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && (!('purchasePrice' in request.resource.data)
              || (request.resource.data.purchasePrice is number && request.resource.data.purchasePrice >= 0))
          && (!('packageQuantity' in request.resource.data)
              || (request.resource.data.packageQuantity is number && request.resource.data.packageQuantity > 0));
      }

      // Produtos / fichas tecnicas (ticket)
      match /products/{productId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Logs de auditoria de precos (append-only, expiracao automatica)
      match /price_audit_logs/{logId} {
        allow read, create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;
      }
    }

    // Bloqueia qualquer outra colecao nao mapeada acima
    match /{document=**} {
      allow read, write: if false;
    }
  }
}