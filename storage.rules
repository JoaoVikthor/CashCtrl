rules_version = '2';

// Regras do Firebase Storage do CashCtrl.
//
// Principio: isolamento por UID (RN02). Cada usuario so pode ler/escrever
// arquivos dentro de users/{uid}/...

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Bloqueia qualquer outro caminho
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}